platform :ios, '16.0'

plugin 'cocoapods-art', :sources => [
  'cocoa-pro-fphi'
]

source 'https://cdn.cocoapods.org/'

def kmp_selphid_host_extractors
  pod 'FPHISelphIDExtractorV1', '~> 1.2.4'
  pod 'FPHISelphIDExtractorV2', '~> 1.2.3'
  pod 'FPHISelphIDExtractorV3', '~> 1.2.6'
end

target 'demosdk' do
  use_frameworks!

  pod 'FPHISDKMainComponent', '~> 4.0.0'
  pod 'FPHISDKSelphIDComponent', '~> 4.0.0'
  kmp_selphid_host_extractors
  pod 'FPHISDKSelphiComponent', '~> 4.0.0'
  pod 'FPHISDKStatusComponent', '~> 4.0.0'
  pod 'FPHISDKTokenizeComponent', '~> 4.0.0'
  pod 'FPHISDKTrackingComponent', '~> 4.0.0'
  pod 'FPHISDKVideoRecordingComponent', '~> 4.0.0'
  pod 'FPHISDKNFCComponent', '~> 4.0.0'
  pod 'FPHISDKTermsConditionsComponent', '~> 4.0.0'
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '16.0'
      config.build_settings['EXPANDED_CODE_SIGN_IDENTITY'] = ""
      config.build_settings['CODE_SIGNING_REQUIRED'] = "NO"
      config.build_settings['CODE_SIGNING_ALLOWED'] = "NO"
    end
  end
end
